{
  "name": "pisound",
  "version": "0.1.0",
  "packageManager": "pnpm@11.23.0",
  "description": "Sound and microphone controller service for BSS Soundweb London (HiQnet) in the Raspberry Pi production ecosystem",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "tsx --test tests/**/*.test.ts",
    "cli": "tsx src/cli.ts",
    "sim": "node scripts/simulate-soundweb.mjs"
  },
  "bin": {
    "pisound": "bin/pisound.mjs"
  },
  "dependencies": {
    "fastify": "^5.2.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.9.0"
  },
  "files": [
    "dist",
    "bin"
  ],
  "pi": {
    "service": "pisound",
    "displayName": "PiSound",
    "layer": "Layer 1: Southbound hardware",
    "port": 3105,
    "ports": {},
    "healthEndpoint": "/health",
    "envPortVar": "PISOUND_PORT"
  }
}
